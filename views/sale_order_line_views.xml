<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Por qué: agrega columna toggle "Pedir Cotización" y botón historial
         en la lista de líneas del presupuesto de venta. -->
    <record id="view_order_form_inherit_cotizar" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cotizar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="x_pedir_cotizacion" widget="boolean_toggle"/>
                <!-- Por qué: botón por línea que abre wizard con últimas 10
                     operaciones de ese producto + cliente. -->
                <button name="action_ver_historial_precios"
                        type="object"
                        icon="fa-history"
                        title="Ver historial de precios"
                        class="btn-link"/>
            </xpath>
        </field>
    </record>
</odoo>
