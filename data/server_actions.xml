<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Por qué: binding_model_id + binding_view_types='list' → aparece en
         el dropdown "Acción" al seleccionar registros en la vista lista.
         Reemplaza las automatizaciones de Studio v17. -->

    <record id="action_server_esperando_precio" model="ir.actions.server">
        <field name="name">Cotización cargada, esperando precio</field>
        <field name="model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_esperando_precio()</field>
    </record>

    <record id="action_server_marcar_listo" model="ir.actions.server">
        <field name="name">Marcar como Listo</field>
        <field name="model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_marcar_listo()</field>
    </record>

    <record id="action_server_cotizaciones" model="ir.actions.server">
        <field name="name">Cotizaciones</field>
        <field name="model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_cotizaciones()</field>
    </record>

    <!-- Por qué: reemplaza la acción Studio v17 (ID 1043) que usaba uom_po_id
         (removido en Odoo 19). Crea solicitudes de compra agrupadas por moneda + compañía. -->
    <record id="action_server_crear_cotizacion_compra" model="ir.actions.server">
        <field name="name">Crear Cotización de Compra</field>
        <field name="model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_model_id" ref="model_x_productos_a_cotizar"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_crear_cotizacion_compra()</field>
    </record>

</odoo>
