<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="historial_precios_wizard_form" model="ir.ui.view">
        <field name="name">historial.precios.wizard.form</field>
        <field name="model">historial.precios.wizard</field>
        <field name="arch" type="xml">
            <form string="Historial de precios">
                <group>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="order_name" string="Nro Cotización"/>
                        <field name="date" string="Fecha"/>
                        <field name="product_name" string="Producto"/>
                        <field name="quantity" string="Cantidad"/>
                        <field name="price_unit" string="Precio unitario"/>
                        <field name="price_total" string="Precio total"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
